def dataframe_to_list_of_lists(route_df: pd.DataFrame) -> list[list[str]]:
    if route_df.empty:
        return []
    return [list(_clean_route_for_scoring(route)) for route in route_df["route"].tolist()]



def dataframe_to_solution_records(route_df: pd.DataFrame) -> list[dict[str, Any]]:
    if route_df.empty:
        return []

    records: list[dict[str, Any]] = []
    for (original_route_id, solution_id), row in route_df.iterrows():
        records.append(
            {
                "original_route_id": str(original_route_id),
                "solution_id": str(solution_id),
                "route": list(_clean_route_for_scoring(row["route"])),
                "original_route": list(_clean_route_for_scoring(row["original_route"])),
            }
        )
    return records



def export_outputs(
    output_dir: Path,
    matrices: dict[str, Optional[pd.DataFrame]],
    original_routes_df: pd.DataFrame,
    solutions_df: pd.DataFrame,
) -> None:
    output_dir.mkdir(parents=True, exist_ok=True)

    original_routes_df.to_csv(output_dir / "original_routes_columnwise.csv")
    solutions_df.to_csv(output_dir / "candidate_solutions_columnwise.csv")

    with (output_dir / "candidate_solutions_list_of_lists.json").open("w", encoding="utf-8") as handle:
        json.dump(dataframe_to_list_of_lists(solutions_df), handle, indent=2)

    with (output_dir / "candidate_solutions_records.json").open("w", encoding="utf-8") as handle:
        json.dump(dataframe_to_solution_records(solutions_df), handle, indent=2)

    matrix_summary_rows = []
    for matrix_name, matrix in matrices.items():
        matrix_summary_rows.append(
            {
                "matrix_name": matrix_name,
                "loaded": matrix is not None,
                "rows": int(matrix.shape[0]) if matrix is not None else 0,
                "cols": int(matrix.shape[1]) if matrix is not None else 0,
            }
        )
    pd.DataFrame(matrix_summary_rows).to_csv(output_dir / "matrix_load_summary.csv", index=False)




